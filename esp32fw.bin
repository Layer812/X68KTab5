54090     color 2
54100     print "        ‚ªƒI[ƒvƒ“‚Å‚«‚Ü‚¹‚ñ‚Å‚µ‚½B"
54110     print "        ‰½‚©ƒL[‚ğ‰Ÿ‚µ‚Ä‰º‚³‚¢B"
54120     color 3
54130     error on
54140     s=inkey$
54150     return()
54160   }
54170   repeat
54180     cls
54190     for i=0 to 29
54200       freads(s,fp)
54210       print s
54220     next
54230     c=asc(inkey$)
54240     if (c <> ' ') then break
54250   until feof(fp)
54260   fclose(fp)
54270   error on
54280 endfunc
