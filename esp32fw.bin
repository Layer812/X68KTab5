26060     pal(i,0)=0
26070     pal(i,1)=&H5294
26080     pal(i,2)=&H20
26090     pal(i,3)=&H3E
26100     pal(i,4)=&H400
26110     pal(i,5)=&H7C0
26120     pal(i,6)=&H420
26130     pal(i,7)=&H7FE
26140     pal(i,8)=&H8000
26150     pal(i,9)=&HF800
26160     pal(i,10)=&H8020
26170     pal(i,11)=&HF83E
26180     pal(i,12)=&H8400
26190     pal(i,13)=&HFFC0
26200     pal(i,14)=&HAD6A
26210     pal(i,15)=&HFFFE
26220     for j=0 to 15
26230       sp_color(j,pal(i,j),i)
26240       dot(XX5+j,YY53+i*2,pal(i,j))
26250     next
26260   next
26270   for i=0 to 15
26280     dot(XX7,YY71+i,pal(l,i))
26290   next
26300   pattern(l)
26310   sp_set(0,,,254)
26320 endfunc
