54010 func type_doc()
54020   int fp,i,j,c
54030   str s[80]
54040   error off
54050   fp=fopen(help_file,"r")
54060   if (fp < 0) then {
54070     locate 0,22,0
54080     print "        ";chr$(34);help_file;chr$(34)
54090     color 2
54100     print "        ‚ЄѓIЃ[ѓvѓ“‚Е‚«‚Ь‚№‚с‚Е‚µ‚ЅЃB"
54110     print "        ‰Ѕ‚©ѓLЃ[‚р‰џ‚µ‚Д‰є‚і‚ўЃB"
54120     color 3
54130     error on
54140     s=inkey$
54150     return()
54160   }
54170   repeat
54180     cls
54190     for i=0 to 29
54200       freads(s,fp)
54210       print s
54220     next
54230     c=asc(inkey$)
54240     if (c <> ' ') then break
54250   until feof(fp)
54260   fclose(fp)
54270   error on
54280 endfunc
