21090     sp_pat(n,temp)
21100     att=bg_get(1,x0,y0)
21110     sp_def(n,w)
21120     bg_put(1,x0,y0,n+256*l)
21130     if (not sure()) then {
21140       sp_def(n,temp)
21150       bg_put(1,x0,y0,att)
21160     }
21170     restore(n)
21180   }
21190   sp_off(1)
21200 endfunc
22000 /*+++++++++++++++++++++++
