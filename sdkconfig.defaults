# Build 6.00: production core split. app_main/host initialization stays on CPU0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1 is not set
# CONFIG_ESP_MAIN_TASK_AFFINITY_NO_AFFINITY is not set
CONFIG_ESP_MAIN_TASK_AFFINITY=0x0

# Build 6.12c: PAN filer/M5Unified host init exceeds ESP-IDF's small default main stack.
# app_main deletes itself after worker creation, so this 12 KiB is temporary.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Runtime task statistics were development-only and are disabled in RC builds.
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set
# CONFIG_FREERTOS_USE_TRACE_FACILITY is not set

# Keep TWDT enabled with the proven 15-second window.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# RC USB stability: some HID devices require a longer post-reset recovery interval.
CONFIG_USB_HOST_RESET_RECOVERY_MS=80

# Build 6.11b: make a fresh source ZIP self-contained for M5Stack Tab5 PSRAM.
# Tab5 uses 32 MiB HEX PSRAM at 200 MHz; PX68K also places large BSS tables
# in external RAM and relies on the normal malloc()/heap_caps integration.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
