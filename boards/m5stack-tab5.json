                   "require_upload_port":  true,
                   "speed":  921600,
                   "offset_address":  "0x20000"
               },
    "url":  "https://docs.m5stack.com/en/core/CoreTab5",
    "vendor":  "M5Stack",
    "idf":  {
                "bootloader":  {
                                   "extra_flags":  "-D CONFIG_ESPTOOLPY_FLASHSIZE_16MB="
                               }
            }
}
